import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int i = 0;
        int j = n;
        while(n > 0) {
            n = n/10;
            i++;
        }
        System.out.println("Number of digit in " + j + " are : " + i );
    }
}
